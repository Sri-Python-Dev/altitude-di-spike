            "st": "",
            "ls": "",
            "cc": "",
            "pv": ""
          },
          {
            "_id": "total_mismatch",
            "q": "",
            "d": "",
            "p": "",
            "st": "!= null",
            "ls": "!= null and abs(stated_total - $) > abs(stated_total) * 0.01",
            "cc": "",
            "pv": "",
            "fc": "\"TOTAL_MISMATCH\"",
            "sv": "\"review\"",
            "fl": "\"stated_total\"",
            "ms": "\"Stated total differs from the sum of the line items by more than 1%\""
