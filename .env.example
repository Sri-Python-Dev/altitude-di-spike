# Copy to .env and fill in. Never commit .env.

# Model calls (llm/config.yaml). Public OpenAI for the spike; Azure AI Foundry later.
OPENAI_API_KEY=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_BASE_URL=

# Results database. Windows example: postgresql://postgres:<password>@localhost:5432/altitude_di
DATABASE_URL=
# Tests use their own database (emptied by every test run)
ALTITUDE_TEST_DATABASE_URL=

# Temporal (defaults shown)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_UI=http://localhost:8233

# Azure Document Intelligence dev resource (parser comparison, task 06)
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=

# Microsoft Graph mail monitor (email_monitor.py --source graph).
# OFF until reading a real mailbox is approved (CLAUDE.md). Test mailbox, synthetic documents only.
MAIL_MONITOR_ENABLED=false
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=
GRAPH_FOLDER=Inbox
GRAPH_ALLOWED_SENDERS=

# Windows: UTF-8 console output (field names and ticks print correctly)
PYTHONUTF8=1

# Corporate network, if needed:
# HTTPS_PROXY=http://proxy.company.com:8080
# SSL_CERT_FILE=C:\path\to\company-root-ca.pem

# Evaluation datasets (eval/datasets.py). Your own golden set: a folder of PDFs + golden JSON files.
ALTITUDE_GOLDEN_DATASET=data/golden/quotes-v1
# Run alongside it (edge cases and demo quotes). Leave empty to run the golden set alone.
ALTITUDE_EXTRA_DATASETS=data/synthetic/edge-cases,data/synthetic
